# Local demo defaults. This file contains no live secrets.
API_URL=http://127.0.0.1:8000
# Supabase (shared project): copy this file to .env, then in the commented line below
#   1. delete the leading "# " and the empty DATABASE_URL= line under it,
#   2. replace [YOUR-PASSWORD], brackets included, with the database password
#      (ask the project owner; percent-encode special characters, e.g. @ -> %40).
# Leave DATABASE_URL empty to use the local SQLite file instead. Never commit the password.
# DATABASE_URL=postgresql://postgres.lajgxeoofrgsizmpixyw:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_PATH=backend/local.db
# Sign in with Google, limited to ScarletMail. The client ID is public (not a secret);
# create it in Google Cloud Console > APIs & Services > Credentials (see README).
# Without it, only the local demo accounts below can sign in (demo mode).
GOOGLE_CLIENT_ID=336188123794-097nk7ur0529vno2sqq32km7gbr2l7up.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAINS=scarletmail.rutgers.edu
DEMO_MODE=1
DEMO_REFERENCE_DATE=2026-10-22
# Set a comma-separated list to the exact browser origins when deploying.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Enable only behind HTTPS. Production should disable demo fixtures/accounts.
COOKIE_SECURE=0
