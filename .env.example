# Local demo defaults. This file contains no live secrets.
API_URL=http://127.0.0.1:8000
DATABASE_PATH=backend/local.db
DEMO_MODE=1
DEMO_REFERENCE_DATE=2026-10-22
# Set a comma-separated list to the exact browser origins when deploying.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Enable only behind HTTPS. Production should disable demo fixtures/accounts.
COOKIE_SECURE=0
